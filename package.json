{
  "name": "yotsumado",
  "version": "1.0.1",
  "description": "ヨツマド — 4つのペインで使うWindows向けファイルエクスプローラー",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/build-native.js && electron .",
    "build": "node scripts/build-native.js && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.myexplorer.app",
    "productName": "ヨツマド",
    "files": [
      "src/**/*",
      "build/icon.ico"
    ],
    "extraResources": [
      { "from": "build/native", "to": "native", "filter": ["*.exe"] }
    ],
    "win": {
      "executableName": "Yotsumado",
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Yotsumado-Setup-${version}-win-${arch}.${ext}",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "language": "1041"
    }
  }
}
